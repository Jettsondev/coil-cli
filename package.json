{
  "name": "coil-cli",
  "version": "0.2.0",
  "description": "See your NVIDIA GPU in real time — a beautiful, live-updating TUI replacement for nvidia-smi.",
  "type": "module",
  "bin": {
    "coil": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.tsx",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nvidia",
    "gpu",
    "monitor",
    "nvidia-smi",
    "tui",
    "cli",
    "ink",
    "react",
    "cuda",
    "rtx"
  ],
  "author": "Bryan Rodas / RWX-TEK INC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jettsondev/coil-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jettsondev/coil-cli/issues"
  },
  "homepage": "https://github.com/jettsondev/coil-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "execa": "^9.6.1",
    "ink": "^5.2.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
